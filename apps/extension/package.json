{
  "name": "@aegis/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:no-network": "tsx scripts/check-no-network.ts"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "@webgpu/types": "^0.1.72",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
