{
  "$id": "https://aegis.local/schema/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGIS common definitions",
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^n-[0-9a-z]+$"
    },
    "textRunId": {
      "type": "string",
      "pattern": "^t-[0-9a-z]+$"
    },
    "frameId": {
      "type": "string",
      "pattern": "^f-[0-9]+$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^s-[0-9]+$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "UUIDv4-shaped. A pattern, not format:uuid, so the standalone Ajv validator needs no runtime format module."
    },
    "placeholderRef": {
      "type": "string",
      "pattern": "^⟪[A-Z_]+#[0-9]+⟫$"
    },
    "box": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "[x, y, w, h] in CSS pixels, top-level viewport, origin top-left"
    },
    "entityType": {
      "enum": [
        "PASSWORD", "OTP", "CARD_NUMBER", "CARD_CVV", "CARD_EXPIRY",
        "AADHAAR", "FACE", "ID_DOCUMENT", "SIGNATURE", "QR_CODE", "SECRET",
        "EMAIL", "PHONE", "ADDRESS", "DOB", "BANK_ACCOUNT", "PAN", "GSTIN",
        "IFSC", "UPI_VPA", "PASSPORT", "VEHICLE_REG", "PERSON_NAME", "USERNAME",
        "PIN_CODE", "DATE", "AMOUNT", "CITY", "COUNTRY",
        "UNKNOWN_SENSITIVE", "CAPTCHA", "MEDIA", "LIVE"
      ]
    },
    "sensitivity": {
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "channel": {
      "enum": ["dom", "text-dom", "text-ocr", "ner", "vision"]
    }
  }
}
