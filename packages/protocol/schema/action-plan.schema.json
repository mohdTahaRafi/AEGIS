{
  "$id": "https://aegis.local/schema/action-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionPlan (StepResponse)",
  "description": "design.md §4.5/§4.6. Also used as the vLLM structured-decoding grammar (Phase 2, T-2.36) — a hallucinated action is a parse error, not a click.",
  "type": "object",
  "required": ["step_id", "actions"],
  "additionalProperties": false,
  "properties": {
    "step_id": { "$ref": "common.schema.json#/$defs/stepId" },
    "plan_id": { "type": "string", "maxLength": 40 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/action" }
    },
    "risk_hint": { "enum": ["low", "medium", "high"] },
    "stop_if": {
      "type": "array",
      "items": { "enum": ["navigation_to_other_origin", "captcha_detected", "form_error_shown"] }
    },
    "note": { "type": "string", "maxLength": 200 }
  },
  "$defs": {
    "webUrl": { "type": "string", "maxLength": 2000, "pattern": "^https?://[^\\s\\u27ea\\u27eb]+$" },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "maxLength": 40 },
        "name": { "type": "string", "maxLength": 120 },
        "box_tolerance_px": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "node"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "click" },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" },
            "expect": { "$ref": "#/$defs/expect" }
          }
        },
        {
          "type": "object",
          "required": ["op", "node", "ref"],
          "additionalProperties": false,
          "description": "type with a vault ref (OQ-1). Disjoint from the literal-text branch below — 'text' is deliberately not a declared property here, so a payload carrying both is rejected by additionalProperties:false rather than relying on an inner oneOf, which a JSON-Schema-to-Pydantic generator can silently flatten into two independently-optional fields (see Phase 1 Implementation Notes).",
          "properties": {
            "op": { "const": "type" },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" },
            "ref": { "$ref": "common.schema.json#/$defs/placeholderRef" },
            "clear_first": { "type": "boolean" },
            "expect": { "$ref": "#/$defs/expect" }
          }
        },
        {
          "type": "object",
          "required": ["op", "node", "text"],
          "additionalProperties": false,
          "description": "type with literal text (OQ-14). If OQ-14 is decided 'no', delete this branch entirely — a one-hunk change, as design.md §4.6 intends.",
          "properties": {
            "op": { "const": "type" },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" },
            "text": { "type": "string", "maxLength": 2000 },
            "clear_first": { "type": "boolean" },
            "expect": { "$ref": "#/$defs/expect" }
          }
        },
        {
          "type": "object",
          "required": ["op", "node", "option"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "select" },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" },
            "option": { "type": "string", "maxLength": 200 },
            "expect": { "$ref": "#/$defs/expect" }
          }
        },
        {
          "type": "object",
          "required": ["op", "direction"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "scroll" },
            "direction": { "enum": ["up", "down", "left", "right"] },
            "amount": { "enum": ["small", "page", "end"] },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" }
          }
        },
        {
          "type": "object",
          "required": ["op", "ms"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "wait" },
            "ms": { "type": "integer", "minimum": 50, "maximum": 5000 }
          }
        },
        {
          "type": "object",
          "required": ["op", "x", "y", "label"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "click_point" },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "label": { "type": "string", "maxLength": 80 }
          }
        },
        {
          "type": "object",
          "required": ["op", "level"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "request_observation" },
            "level": { "enum": ["L1", "L2"] },
            "region": { "$ref": "common.schema.json#/$defs/box" }
          }
        },
        {
          "type": "object",
          "required": ["op", "content"],
          "additionalProperties": false,
          "description": "content may carry placeholders; the panel resolves them locally for display only, never re-sends them resolved.",
          "properties": {
            "op": { "const": "report" },
            "title": { "type": "string", "maxLength": 80 },
            "content": { "type": "string", "maxLength": 4000 }
          }
        },
        {
          "type": "object",
          "required": ["op", "question"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "ask_user" },
            "question": { "type": "string", "maxLength": 300 }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "done" },
            "summary": { "type": "string", "maxLength": 300 }
          }
        },
        {
          "type": "object",
          "required": ["op", "reason"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "stop" },
            "reason": { "enum": ["captcha", "blocked", "cannot_proceed", "unsafe"] },
            "detail": { "type": "string", "maxLength": 200 }
          }
        },
        {
          "type": "object",
          "required": ["op", "key"],
          "additionalProperties": false,
          "description": "A key press on `node` (focused first), or on whatever has focus when `node` is absent.",
          "properties": {
            "op": { "const": "press_key" },
            "key": { "enum": ["Enter", "Tab", "Escape", "Backspace", "Delete", "Space", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "PageUp", "PageDown", "Home", "End"] },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" }
          }
        },
        {
          "type": "object",
          "required": ["op", "node"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "hover" },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" }
          }
        },
        {
          "type": "object",
          "required": ["op", "node"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "double_click" },
            "node": { "$ref": "common.schema.json#/$defs/nodeId" },
            "expect": { "$ref": "#/$defs/expect" }
          }
        },
        {
          "type": "object",
          "required": ["op", "url"],
          "additionalProperties": false,
          "description": "Loads `url` in the task's tab. http(s) only; never a placeholder (a sealed value is never put in a URL).",
          "properties": {
            "op": { "const": "navigate" },
            "url": { "$ref": "#/$defs/webUrl" }
          }
        },
        {
          "type": "object",
          "required": ["op", "url"],
          "additionalProperties": false,
          "description": "Opens `url` in a new tab, which becomes the task's tab (e.g. the task belongs on another site).",
          "properties": {
            "op": { "const": "open_tab" },
            "url": { "$ref": "#/$defs/webUrl" }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": { "op": { "enum": ["go_back", "go_forward", "reload"] } }
        }
      ]
    }
  }
}
