# architecture §13.2 / phase_5_measurement.md §7, T-5.11 (FR-46, NFR-13) — env vars that force
# every model-loading library in the stack to refuse any network access, so a container that
# somehow still had connectivity would fail loudly (a missing local file) rather than silently
# reaching out. Sourced by the gateway and vLLM services in docker-compose.offline.yml, in
# addition to (not instead of) vllm.env's AEGIS_TOKEN etc.

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# vLLM reads HF_HUB_OFFLINE itself; no separate vLLM-specific flag is needed as of the version
# pinned in gateway.Dockerfile / vllm/vllm-openai:latest.
