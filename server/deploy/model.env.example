# Gateway model settings. Copy to model.env (gitignored), chmod 600, fill in the key, then
#   set -a; . server/deploy/model.env; set +a
# Never commit model.env, never paste the key into chat, tickets or logs. Keys: console.groq.com
# -> API Keys (free tier, no billing). If a key is ever exposed, delete it there and make a new one.

# --- Demo / development: Groq free tier (R-1 decision, docs/planning/bugs/R-1-vlm-endpoint.md) ---
AEGIS_MODE=live                          # live | record | replay
AEGIS_MODEL_URL=https://api.groq.com/openai/v1
AEGIS_MODEL_NAME=qwen/qwen3.8-27b        # Groq's only image-input model (Preview), checked 2026-09-28
AEGIS_MODEL_API_KEY=                     # gsk_...  sent as `Authorization: Bearer` (R-2)
AEGIS_MODEL_TIMEOUT_S=30
AEGIS_MODEL_VISION=true                  # send the guarded WebP as an image part (R-2)
AEGIS_MODEL_MAX_TOKENS=900               # completion budget per step: a plan is ~60-150 tokens, a typed reply up to ~600
AEGIS_MODEL_REASONING_EFFORT=none        # Groq: turn Qwen's thinking off (saves daily-quota tokens)
AEGIS_MODEL_POINT_FORMAT=rel1000_long_side  # measured click_point convention for qwen/qwen3.8-27b
# Groq answers HTTP 400 to `chat_template_kwargs`, and to strict json_schema with the action-plan
# schema (it has optional keys), so both values below are required on Groq (R-3):
AEGIS_MODEL_RESPONSE_FORMAT=json_object  # json_schema | json_object | none
AEGIS_MODEL_CHAT_TEMPLATE_KWARGS=false   # true only for self-hosted vLLM
# One retry, only for a 429 whose retry-after is <= the max wait, or a dropped connection (R-1).
AEGIS_MODEL_MAX_RETRIES=1
AEGIS_MODEL_RETRY_MAX_WAIT_S=10
# Every step is sent with its screenshot. Optional other VISION models (own per-model budgets
# upstream) that take a step when the primary would make it wait longer than the max wait below;
# never a text-only model. Groq serves one vision model, so empty there.
AEGIS_MODEL_FALLBACKS=
AEGIS_MODEL_PRIMARY_MAX_WAIT_S=4
# A screenshot's cost against the per-minute token budget (Groq, qwen3.8-27b: 2 x 1,807 measured), and
# how long the gateway waits for that budget before telling the client to retry later.
AEGIS_MODEL_IMAGE_BUDGET_TOKENS=3600
AEGIS_MODEL_BUDGET_MAX_WAIT_S=60

# --- Offline: replay recorded plans (R-6) ---
# AEGIS_MODE=replay
# AEGIS_RECORD_DIR=server/deploy/replay-store/demo
