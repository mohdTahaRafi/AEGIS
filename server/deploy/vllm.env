# design.md §12.4 — shared by the gateway and vLLM services in docker-compose.yml.
# Fill in AEGIS_TOKEN with a real secret before any non-local deployment; the default below is
# for local development only and must never be used outside a closed network.

AEGIS_TOKEN=dev-token
AEGIS_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
AEGIS_SESSION_TTL_S=900
AEGIS_MAX_BODY_MB=4
AEGIS_LOG_PAYLOADS=false
AEGIS_MODEL_TIMEOUT_S=20
